#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
    // Left half                                       // Right half 
    
    // (ROW0) 
    &kp ESC   &kp N1   &kp N2    &kp N3    &none       &none     &kp N6    &kp N7    &kp N8   &kp N9
    
    // (ROW1) 
    &kp TAB   &kp Q    &kp W     &kp E     &none       &none     &kp U     &kp I     &kp O    &kp P
    
    // (ROW2) 
    &kp LSHFT &kp A    &kp S     &kp D     &none       &none     &kp J     &kp K     &kp L    &kp ENTER
    
    // (ROW3) 
    &kp LCTRL &kp Z    &kp X     &kp C     &none       &none     &kp N     &kp M     &kp COMMA &kp DOT
    
    // (ROW4) 
    &kp LALT  &kp LGUI &kp SPACE &mo 1     &kp N4      &kp N5    &mo 1     &kp SPACE &kp RGUI &kp BSPC
            >;
        };

        lower_layer {
            bindings = <
    // Secondary layer
    &none     &none    &none     &none     &none       &none     &none     &kp UP    &none    &kp N0
    &none     &none    &none     &none     &none       &none     &kp LEFT  &kp DOWN  &kp RIGHT &none
    &none     &none    &none     &none     &none       &none     &none     &none     &none    &none
    &none     &none    &none     &none     &none       &none     &none     &none     &none    &none
    &none     &none    &none     &none     &none       &none     &none     &none     &none    &none
            >;
        };
    };
};